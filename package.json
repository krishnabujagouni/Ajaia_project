    "@tiptap/react": "^3.35.1",
    "@tiptap/starter-kit": "^3.35.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
